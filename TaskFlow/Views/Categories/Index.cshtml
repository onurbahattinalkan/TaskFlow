@* Projenin kategori listesi (sadece Lider / Admin) *@
@model CategoryIndexViewModel

@{
    ViewData["Title"] = "Kategoriler · " + Model.ProjectName;
    // Sol menülü proje iskeleti
    Layout = "_ProjectLayout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Kategoriler</h2>
    @* K2'de gelecek *@
    <a asp-action="Create" asp-route-projectId="@Model.ProjectId" class="btn btn-primary">+ Yeni Kategori</a>
</div>

@* Başarı / hata mesajları *@
<partial name="_TempDataAlerts" />

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        Bu projede henüz kategori yok. "+ Yeni Kategori" ile ya da görev eklerken oluşturabilirsin.
    </div>
}
else
{
    <div class="card shadow-sm">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Kategori</th>
                    <th class="text-center">Görev Sayısı</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Items)
                {
                    <tr>
                        @* Adı, kendi renginde rozet olarak göster (görev listesindekiyle aynı görünüm) *@
                        <td><span class="badge fs-6" style="background-color: @c.Color;">@c.Name</span></td>
                        <td class="text-center">@c.TaskCount</td>
                        <td class="text-end text-nowrap">
                            @* K3 ve K4'te gelecek *@
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}