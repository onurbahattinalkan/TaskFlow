@* Bu form tek bir Project ile çalışır *@
@model TaskFlow.Models.Project

@{
    ViewData["Title"] = "Yeni Proje";
}

<h1>Yeni Proje</h1>

<div class="row">
    <div class="col-md-6">
        @* asp-action="Create" → POST /Projects/Create'e gönderir.
           Form tag helper anti-forgery token'ı otomatik ekler. *@
        <form asp-action="Create" method="post">

            @* Belirli bir alana ait olmayan genel hatalar burada görünür *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* Proje adı *@
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            @* Açıklama (çok satırlı) *@
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            @* Tarihler yan yana, tarayıcının tarih seçicisiyle *@
            <div class="row">
                <div class="col mb-3">
                    <label asp-for="StartDate" class="form-label"></label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
                <div class="col mb-3">
                    <label asp-for="EndDate" class="form-label"></label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>

            @* Ekip seçimi: seçenekler controller'daki ViewBag.Teams'ten gelir *@
            <div class="mb-3">
                <label asp-for="TeamId" class="form-label"></label>
                <select asp-for="TeamId" asp-items="ViewBag.Teams" class="form-select">
                    <option value="">-- Ekip seçin --</option>
                </select>
                <span asp-validation-for="TeamId" class="text-danger"></span>
            </div>

            @* Butonlar *@
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
        </form>
    </div>
</div>

@* Doğrulama scriptleri: hataları sayfa yenilenmeden gösterir
   (_Layout'taki "Scripts" bölümüne yerleşir) *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}