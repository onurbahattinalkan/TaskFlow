@model List<TeamListItemViewModel>

@{
    ViewData["Title"] = "Ekiplerim";
}

@* Create'ten yönlendirildiysek başarı mesajını bir kez göster *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Ekiplerim</h2>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Ekip</a>
</div>

@if (Model.Count == 0)
{
    @* Boş durum: kullanıcıya ne yapacağını söyle *@
    <div class="text-center text-muted py-5">
        <p class="mb-2">Henüz bir ekibe üye değilsiniz.</p>
        <p class="small">Yeni bir ekip kurun ya da bir ekip liderinin sizi eklemesini bekleyin.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var team in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h3 class="h5 mb-0">@team.Name</h3>
                            @* Lider ise mavi, üye ise gri rozet *@
                            <span class="badge @(team.MyRole == TeamRoles.Leader ? "bg-primary" : "bg-secondary")">
                                @team.MyRole
                            </span>
                        </div>
                        <p class="text-muted small mb-2">@(team.Description ?? "Açıklama yok")</p>
                        <p class="small mb-0">👥 @team.MemberCount üye</p>
                    </div>
                </div>
            </div>
        }
    </div>
}