@* Yönetici görev sayfası: üstte yeni görev formu, altta kişiye göre gruplu liste, düzenleme pop-up'ı *@
@model TaskManageViewModel

@{
    ViewData["Title"] = "Görevler · " + Model.ProjectName;
    Layout = "_ProjectLayout";

    // Form açık mı gelsin? Hata varsa ya da hiç görev yoksa açık.
    var showForm = !ViewData.ModelState.IsValid || !Model.Groups.Any();

    // Durum rozetinin yazısı ve rengi
    (string Text, string Css) StatusBadge(TaskItemStatus s) => s switch
    {
        TaskItemStatus.Todo => ("Yapılacak", "text-bg-secondary"),
        TaskItemStatus.InProgress => ("Devam Ediyor", "text-bg-primary"),
        _ => ("Tamamlandı", "text-bg-success")
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Görevler</h2>
    <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#yeni-gorev">
        + Yeni Görev
    </button>
</div>

<partial name="_TempDataAlerts" />

@* ================= YENİ GÖREV FORMU ================= *@
<div id="yeni-gorev" class="collapse @(showForm ? "show" : "") mb-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <input type="hidden" asp-for="Form.ProjectId" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                @* Ortak alanlar (düzenleme pop-up'ı da aynısını kullanır) *@
                <partial name="_TaskFormFields"
                         model='new TaskFormModel { Form = Model.Form, Categories = Model.Categories, IsEdit = false }' />

                <button type="submit" class="btn btn-primary mt-2">Görevi Oluştur</button>
            </form>
        </div>
    </div>
</div>

@* ================= KİŞİYE GÖRE GRUPLU LİSTE ================= *@
@if (!Model.Groups.Any())
{
    <div class="alert alert-info">Bu projede henüz görev yok. Yukarıdaki formdan ilk görevi oluştur.</div>
}
else
{
    @* Toplu işlem çubuğu: Tümünü seç + seçili sayısı + Seçilenleri sil *@
    <div class="d-flex align-items-center gap-3 mb-2 p-2 bg-light rounded border">
        <div class="form-check mb-0 ms-1">
            <input class="form-check-input" type="checkbox" id="select-all" />
            <label class="form-check-label" for="select-all">Tümünü seç</label>
        </div>
        <span class="small text-muted" id="selected-count">0 seçili</span>

        @* Satırlardaki checkbox'lar form="bulk-delete-form" özelliğiyle BU forma bağlı.
           (Tablonun içinde satır silme formları olduğu için iç içe form kullanamıyoruz.) *@
        <form id="bulk-delete-form" asp-action="DeleteAssignments" method="post" class="ms-auto">
            <input type="hidden" name="projectId" value="@Model.ProjectId" />
            <button type="submit" class="btn btn-sm btn-danger" id="bulk-delete-btn" disabled>Seçilenleri sil</button>
        </form>
    </div>
}

@foreach (var g in Model.Groups)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <span class="fw-semibold">@g.UserName</span>
                <span class="small text-muted ms-1">@g.FullName</span>
            </div>
            <span class="badge text-bg-light border">@g.Rows.Count görev</span>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 2rem;"></th>
                        <th>Görev</th>
                        <th>Kategori</th>
                        <th>Atanma</th>
                        <th>Deadline</th>
                        <th>Kalan</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in g.Rows)
                    {
                        var (statusText, statusCss) = StatusBadge(r.Status);
                        <tr>
                            @* Toplu silme için seçim kutusu: değeri ATAMA Id'si *@
                            <td>
                                <input type="checkbox" class="form-check-input row-check"
                                       name="ids" value="@r.AssignmentId" form="bulk-delete-form" />
                            </td>
                            <td>
                                <div class="fw-semibold">@r.Title</div>
                                @if (!string.IsNullOrWhiteSpace(r.Description))
                                {
                                    <div class="small text-muted">@(r.Description.Length > 80 ? r.Description[..80] + "…" : r.Description)</div>
                                }
                            </td>
                            <td><span class="badge" style="background-color: @r.CategoryColor;">@r.CategoryName</span></td>
                            <td class="small">@TimeHelper.Format(r.AssignedAt)</td>
                            <td class="small">@TimeHelper.Format(r.DueDate)</td>
                            <td class="small">
                                @if (r.Status == TaskItemStatus.Done)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    var (remText, remCss) = TimeHelper.Remaining(r.DueDate);
                                    <span class="fw-semibold @remCss">@remText</span>
                                }
                            </td>
                            <td><span class="badge @statusCss">@statusText</span></td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary edit-task-btn"
                                        data-url="@Url.Action("Edit", new { id = r.TaskId })">Düzenle</button>

                                @* Satır silme: görevi SADECE bu kişiden kaldırır *@
                                <form asp-action="DeleteAssignment" asp-route-id="@r.AssignmentId" method="post" class="d-inline"
                                      onsubmit="return confirm('“@r.Title” görevi sadece @g.UserName kişisinden kaldırılacak. Emin misin?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* ================= DÜZENLEME POP-UP'I (içi boş, JavaScript doldurur) ================= *@
<div class="modal fade" id="editTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Görevi Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body"></div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/task-form.js" asp-append-version="true"></script>

    <script>
        (function () {
            // Yeni Görev formunun davranışları
            initTaskForm(document.getElementById('yeni-gorev'));
                        // ---------- Toplu seçim ve silme ----------
            const selectAll = document.getElementById('select-all');
            if (selectAll) {   // liste boşsa çubuk yok
                const rowChecks = [...document.querySelectorAll('.row-check')];
                const countEl = document.getElementById('selected-count');
                const bulkBtn = document.getElementById('bulk-delete-btn');
                const bulkForm = document.getElementById('bulk-delete-form');
                const selectedCount = () => rowChecks.filter(c => c.checked).length;

                // Sayaç, buton ve "Tümünü seç" kutusunun durumunu güncelle
                function refreshBulk() {
                    const n = selectedCount();
                    countEl.textContent = `${n} seçili`;
                    bulkBtn.disabled = n === 0;
                    selectAll.checked = n > 0 && n === rowChecks.length;
                    selectAll.indeterminate = n > 0 && n < rowChecks.length;   // bir kısmı seçiliyse "—"
                }

                // Tümünü seç / bırak
                selectAll.addEventListener('change', () => {
                    rowChecks.forEach(c => c.checked = selectAll.checked);
                    refreshBulk();
                });
                rowChecks.forEach(c => c.addEventListener('change', refreshBulk));

                // Göndermeden önce onay
                bulkForm.addEventListener('submit', e => {
                    const n = selectedCount();
                    const ok = confirm(`Seçilen ${n} atama silinecek. Kimseye atanmış hali kalmayan görevler tamamen silinir. Emin misin?`);
                    if (!ok) e.preventDefault();
                });

                refreshBulk();
            }

            const modalEl = document.getElementById('editTaskModal');
            const modal = new bootstrap.Modal(modalEl);   // Bootstrap'in pop-up nesnesi
            const body = modalEl.querySelector('.modal-body');

            // "Düzenle" → formu sunucudan iste, pop-up'a koy
            document.querySelectorAll('.edit-task-btn').forEach(btn => {
                btn.addEventListener('click', async () => {
                    body.innerHTML = '<div class="text-center py-4"><div class="spinner-border"></div></div>';
                    modal.show();

                    const res = await fetch(btn.dataset.url);
                    if (!res.ok) {
                        body.innerHTML = '<div class="alert alert-danger">Görev yüklenemedi.</div>';
                        return;
                    }
                    body.innerHTML = await res.text();
                    wireEditForm();
                });
            });

            // Pop-up'taki formu hazırla ve "Kaydet"i sayfa yenilemeden gönder
            function wireEditForm() {
                initTaskForm(body);
                const form = body.querySelector('form');

                form.addEventListener('submit', async e => {
                    e.preventDefault();   // normal (sayfa değiştiren) gönderimi engelle

                    // FormData: formdaki tüm alanlar + anti-forgery token
                    const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });

                    if (res.ok) {
                        location.reload();   // başarılı → listeyi yenile (yeşil mesaj görünür)
                    } else if (res.status === 400) {
                        body.innerHTML = await res.text();   // hatalı → hatalı formu göster
                        wireEditForm();
                    } else {
                        body.innerHTML = `<div class="alert alert-danger">Kaydedilemedi (hata ${res.status}).</div>`;
                    }
                });
            }
        })();
    </script>
}